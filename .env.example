# ==========================================
# GharCare Environment Configuration Template
# Copy this file to .env and supply your credentials
# ==========================================

# Server Port
PORT=4003

# Google Gemini API Key (Required for Multimodal Vision Extraction)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Environment Mode (development | production)
NODE_ENV=production

# Optional: Google Healthcare / Vertex AI MedLM model name (default: gemini-1.5-flash)
GOOGLE_HEALTHCARE_MODEL="gemini-1.5-flash"

# Optional: Google Cloud Platform Settings (for Cloud TTS / Translation if using service account)
PROJECT_ID="your_gcp_project_id"
GCP_PROJECT_ID="your_gcp_project_id"
GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"
GCS_REGION="asia-south1"
