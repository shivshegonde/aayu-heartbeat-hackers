# ==========================================
# GharCare (घर-केयर) - Production .gitignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & Sensitive Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
gcp-key.json
*-key.json
service-account*.json
credentials*.json

# Production Build Outputs
dist/
**/dist/
build/
out/
.next/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm

# Temporary files & Caches
.cache/
.parcel-cache/
tmp/
temp/
.eslintcache
.stylelintcache
*.tsbuildinfo

# OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Code Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# AI Assistant & IDE Agents
.gemini/
.agents/

# Large Model / OCR Binaries (downloaded dynamically)
*.traineddata

# Test Coverage
coverage/
.nyc_output/
